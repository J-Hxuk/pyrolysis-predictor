# ============================================================
# Git 제외 목록
# 실제 연구 자료·비밀값·로컬 설정·산출물을 저장소에서 제외한다.
# ============================================================

# ── Python 빌드·캐시 ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# ── 가상 환경 ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── 개발 도구 ──────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
test-results/

# ── Jupyter 노트북 출력 ───────────────────────────────────
# 노트북 파일 자체는 포함하되 셀 출력은 Git 커밋 전에 제거한다.
# nbstripout 또는 수동으로 Kernel > Restart & Clear Output 후 저장.
# 노트북 실행 중 생성되는 체크포인트는 제외한다.
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── 실제 연구 데이터 (절대 업로드 금지) ──────────────────
data/
runs/
templates/local/

# ── Streamlit Cloud 배포에 필요한 v15 데이터 파일 예외 ──
# data/ 전체를 제외하되 v15 패키지 파일들은 예외 처리한다.
# 이 파일들은 소형(총 ~2.5 MB)이며 앱 실행에 필수적이다.
!data/
!data/imports/
!data/imports/Stage1_Stage2_Model_Ready_v15/
!data/imports/Stage1_Stage2_Model_Ready_v15/Stage1_Stage2_Model_Ready_v15_20261029/
